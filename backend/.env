# ---------------------------------------------------------------------------
# CITRA AI backend
# ---------------------------------------------------------------------------
SECRET_KEY=citra-secret-key-production-2024
JWT_SECRET_KEY=citra-jwt-secret-production-2024
JWT_EXPIRES_DAYS=7

# Database - the SAME MySQL database Laravel uses (Laragon, port 3307 because
# the standalone MySQL80 Windows service occupies 3306).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=citra_db
DB_USERNAME=root
DB_PASSWORD=

# Set DATABASE_URL to override the DB_* values entirely, e.g.
# DATABASE_URL=mysql+pymysql://root@127.0.0.1:3307/citra_db?charset=utf8mb4

FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_ENV=development
FLASK_DEBUG=1

# Allow the Laravel dev server to talk to this backend.
CORS_ORIGINS=*

# Live scoring tuning
ANGLE_TOLERANCE_DEG=12
POSE_CORRECT_THRESHOLD=70
SESSION_IDLE_TIMEOUT=1800
